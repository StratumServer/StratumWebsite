---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import StrataRule from '../components/StrataRule.astro';
import { getCollection } from 'astro:content';

const newsPosts = (await getCollection('news')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const latest = newsPosts[0];
const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

const layers = [
  {
    tag: 'Layer 01 // Performance',
    color: 'moss',
    title: 'Runs better under load',
    items: [
      'Chunk sending shared fairly between players',
      'Chunk generation budgets and smoother chunk IO',
      'Movement-aware chunk priority and stale request cleanup',
      'Async pathfinding with priority for work near players',
      'Entity, block tick, and autosave smoothing',
      'Lower per-tick overhead and less allocation churn',
    ],
  },
  {
    tag: 'Layer 02 // Tools',
    color: 'ochre',
    title: 'Owner and staff tools built in',
    items: [
      'Homes, spawn, back, tpa, and private messages',
      'Staff tools for vanish, freeze, jail, mute, warn, and notes',
      'Player lookup with whois, seen, and near',
      'Chat prefixes, nametag styling, and server info text',
      'Permission based access for every command',
    ],
  },
  {
    tag: 'Layer 03 // Protection',
    color: 'ore',
    title: 'Guards against bad clients',
    items: [
      'Packet rate limits and queue back-pressure',
      'Oversized custom packet rejection',
      'Server-side block-break validation',
      'Login protection during the join window',
      'Optional client mod policy controls',
      'Map and location privacy options for players',
    ],
  },
];

const goodFor = [
  'Public multiplayer servers',
  'Servers with busy spawn areas',
  'Event and civ-style servers',
  'PvP servers that want privacy and staff tools',
  'Heavier modded servers that need better reports',
  'Communities that want owner tools without a client mod',
];

const edgeColor = {
  moss: 'border-t-moss',
  ochre: 'border-t-ochre',
  ore: 'border-t-ore',
};
const tagColor = {
  moss: 'text-moss-deep',
  ochre: 'text-ochre-deep',
  ore: 'text-ore-deep',
};
const dotColor = {
  moss: 'bg-moss',
  ochre: 'bg-ochre',
  ore: 'bg-ore',
};
---

<Base title="Home" description="Server runtime for Vintage Story dedicated servers.">
  <Nav />

  <main>
    <!-- Hero -->
    <section class="mx-auto max-w-5xl px-6 pt-20 pb-16 sm:pt-24">
      <h1 class="font-display text-6xl font-bold tracking-tight text-ink sm:text-7xl">Stratum</h1>
      <p class="mt-5 max-w-2xl text-xl text-ink">
        A patched server runtime for real Vintage Story multiplayer load.
      </p>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink-soft">
        Stratum runs in place of the stock dedicated server, with over 150 direct game-file patches across
        networking, chunk pressure, entities, worldgen, anti-cheat, and per-tick overhead. Players connect
        with a normal client. You run Stratum for the game version your server is on.
      </p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href="/downloads"
          class="inline-flex items-center justify-center bg-bedrock px-6 py-3 text-sm font-semibold text-parchment-light transition-colors hover:bg-ink"
        >
          Download
        </a>
        <a
          href="https://github.com/StratumServer/Stratum/wiki"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center border border-parchment-line bg-parchment-panel px-6 py-3 text-sm font-semibold text-ink transition-colors hover:border-ink-faint"
        >
          Documentation
        </a>
        <a
          href="https://discord.gg/pd24fawhsD"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-2 py-3 text-sm font-semibold text-ore-deep transition-colors hover:text-ore"
        >
          Join the Discord
        </a>
      </div>
    </section>

    <!-- Latest news -->
    {latest && (
      <section class="mx-auto max-w-5xl px-6 pb-20">
        <div class="mb-5 flex items-baseline justify-between">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-ink-faint">Latest news</p>
          <a href="/news" class="text-sm text-ore-deep transition-colors hover:text-ore">All news &rarr;</a>
        </div>
        <a href={`/news/${latest.id}`} class="group block border-4 border-bedrock bg-bedrock">
          {latest.data.image && (
            <img src={latest.data.image} alt="" class="block h-48 w-full object-cover sm:h-56" />
          )}
          <div class="flex flex-col gap-3 px-4 py-3.5 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <h2 class="font-display text-lg font-bold text-parchment-light transition-colors group-hover:text-white">{latest.data.title}</h2>
              <p class="mt-0.5 font-mono text-xs text-parchment-line">{fmtDate(latest.data.date)}</p>
            </div>
            <div class="flex shrink-0 items-center gap-2">
              <img src={`https://github.com/${latest.data.authorGithub}.png?size=48`} alt="" width="24" height="24" class="rounded-full" />
              <span class="text-xs text-parchment-line">{latest.data.author}</span>
            </div>
          </div>
        </a>
      </section>
    )}

    <StrataRule />

    <!-- What's included -->
    <section class="mx-auto max-w-5xl px-6 py-20">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-ink-faint">What Stratum adds</p>
      <h2 class="mt-3 max-w-2xl font-display text-3xl font-bold text-ink">
        One runtime instead of a stack of mods and scripts
      </h2>
      <div class="mt-12 grid gap-px border border-parchment-line bg-parchment-line sm:grid-cols-3">
        {layers.map(layer => (
          <div class={`border-t-4 ${edgeColor[layer.color]} bg-parchment-panel p-6`}>
            <p class={`font-mono text-xs uppercase tracking-widest ${tagColor[layer.color]}`}>{layer.tag}</p>
            <h3 class="mt-3 mb-5 font-display text-lg font-bold text-ink">{layer.title}</h3>
            <ul class="space-y-2.5 text-sm leading-relaxed text-ink-soft">
              {layer.items.map(item => (
                <li class="flex gap-2.5">
                  <span class={`mt-2 h-1 w-1 shrink-0 ${dotColor[layer.color]}`}></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="mt-8 max-w-2xl text-sm leading-relaxed text-ink-soft">
        When a server starts to lag, the built-in reports give you somewhere real to look. Check timings,
        packets, queues, chunks, entities, players, and violations from in-game with the
        <code class="bg-parchment-sunk px-1.5 py-0.5 font-mono text-xs text-bedrock">/stratum</code> commands.
      </p>
    </section>

    <StrataRule />

    <!-- Get started -->
    <section class="bg-parchment-sunk/60">
      <div class="mx-auto max-w-2xl px-6 py-20">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-ink-faint">Get started</p>
        <h2 class="mt-3 font-display text-3xl font-bold text-ink">Three steps to a running server</h2>
        <ol class="mt-12 space-y-9">
          <li class="flex gap-5">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center border border-parchment-line bg-parchment-panel font-mono text-sm font-semibold text-ochre-deep">1</span>
            <div>
              <p class="font-semibold text-ink">Download the release for your game version</p>
              <p class="mt-1.5 text-sm leading-relaxed text-ink-soft">
                Grab the <code class="bg-parchment-sunk px-1.5 py-0.5 font-mono text-xs text-bedrock">stratum-&lt;version&gt;-&lt;rid&gt;.zip</code>
                for your platform from the
                <a href="https://github.com/StratumServer/Stratum/releases" target="_blank" rel="noopener noreferrer" class="text-ore-deep underline decoration-parchment-line underline-offset-2 transition-colors hover:text-ore">releases page</a>.
                Match the release to the Vintage Story version your server runs.
              </p>
            </div>
          </li>
          <li class="flex gap-5">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center border border-parchment-line bg-parchment-panel font-mono text-sm font-semibold text-ochre-deep">2</span>
            <div>
              <p class="font-semibold text-ink">Extract it</p>
              <p class="mt-1.5 text-sm leading-relaxed text-ink-soft">Unpack the archive wherever you want the server to live.</p>
            </div>
          </li>
          <li class="flex gap-5">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center border border-parchment-line bg-parchment-panel font-mono text-sm font-semibold text-ochre-deep">3</span>
            <div>
              <p class="font-semibold text-ink">Run it</p>
              <div class="mt-3 space-y-2">
                <div class="border-l-2 border-moss bg-bedrock px-4 py-2.5 font-mono text-xs text-parchment-light">
                  <span class="text-parchment-line"># Windows</span><br />
                  StratumServer.exe
                </div>
                <div class="border-l-2 border-ochre bg-bedrock px-4 py-2.5 font-mono text-xs text-parchment-light">
                  <span class="text-parchment-line"># Linux</span><br />
                  ./StratumServer
                </div>
              </div>
              <p class="mt-3 text-sm leading-relaxed text-ink-soft">
                Needs the .NET 10 runtime on the host. On first launch Stratum downloads the matching vanilla
                server files, then runs the patched runtime on top. Your existing world and data folder carry over.
              </p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <StrataRule />

    <!-- Good for + compatibility -->
    <section class="mx-auto max-w-5xl px-6 py-20">
      <div class="grid gap-14 lg:grid-cols-2">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-ink-faint">Good fit for</p>
          <h2 class="mt-3 font-display text-3xl font-bold text-ink">Who runs Stratum</h2>
          <ul class="mt-8 space-y-3 text-sm text-ink-soft">
            {goodFor.map(item => (
              <li class="flex items-start gap-3 border-b border-parchment-line-soft pb-3">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 bg-ochre"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-ink-faint">Before you switch</p>
          <h2 class="mt-3 font-display text-3xl font-bold text-ink">Compatibility</h2>
          <div class="mt-8 space-y-4 text-sm leading-relaxed text-ink-soft">
            <p>
              Stratum is built against a specific Vintage Story version, so use the release that matches your
              server. Players do not install anything extra.
            </p>
            <p>
              Most normal server mods work, but Stratum patches deeper server internals than a regular mod.
              Test your mod list before you move a live server over.
            </p>
            <p class="border-l-2 border-ore bg-parchment-panel px-4 py-3 text-ink">
              Stratum is not compatible with Synergy or Tungsten. Those optimizations are already built into
              Stratum, so running them together conflicts.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
