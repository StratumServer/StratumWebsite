---
import DocsLayout from '../../layouts/DocsLayout.astro';
import StrataRule from '../../components/StrataRule.astro';
import { render } from 'astro:content';
import { getDocs } from '../../lib/docs';

export async function getStaticPaths() {
  const docs = await getDocs();
  return docs
    .filter(doc => doc.id !== 'index' && doc.id !== 'README')
    .map(doc => ({ params: { slug: doc.id }, props: { doc } }));
}

const { doc } = Astro.props;
const { Content, headings } = await render(doc);

const category = doc.data.category
  ?? (doc.id.includes('/') ? doc.id.split('/')[0].replace(/[-_]/g, ' ') : null);
---

<DocsLayout title={doc.data.title} description={doc.data.description} currentId={doc.id} headings={headings}>
  {category && (
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-ochre-deep">{category}</p>
  )}
  <h1 class="mt-3 font-display text-4xl font-bold leading-tight text-ink">{doc.data.title}</h1>
  {doc.data.description && (
    <p class="mt-3 text-lg leading-relaxed text-ink-soft">{doc.data.description}</p>
  )}

  <StrataRule class="mt-8" />

  <article class="prose mt-10 max-w-none">
    <Content />
  </article>
</DocsLayout>
