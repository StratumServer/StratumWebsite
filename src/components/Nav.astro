---
const links = [
  { href: '/downloads', label: 'Downloads', external: false },
  { href: '/news', label: 'News', external: false },
  { href: '/docs', label: 'Docs', external: false },
  { href: '/contribute', label: 'Contribute', external: false },
  { href: '/team', label: 'Team', external: false },
  {
    href: 'https://nimbus.stratumvs.dev',
    label: 'Nimbus',
    external: true,
    project: true,
  },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-parchment-line bg-parchment/85 backdrop-blur-sm">
  <nav aria-label="Main" class="mx-auto flex h-14 w-full max-w-[1600px] items-center justify-between px-4 sm:px-6 2xl:px-8">
    <a href="/" class="flex items-center gap-2.5 transition-opacity hover:opacity-70">
      <img src="/logo-notxt.png" alt="Stratum" width="26" height="26" />
      <span class="text-sm font-semibold tracking-tight text-ink">Stratum</span>
    </a>
    <div class="hidden items-center gap-6 lg:flex">
      {links.map(link => (
        <a
          href={link.href}
          target={link.external ? '_blank' : undefined}
          rel={link.external ? 'noopener noreferrer' : undefined}
          class:list={[
            'group flex items-center gap-1 text-sm transition-colors',
            link.project
              ? 'border-l border-parchment-line pl-4 font-medium text-ochre-deep hover:text-ink'
              : !link.external && currentPath.startsWith(link.href)
                ? 'font-medium text-ink'
                : 'text-ink-soft hover:text-ink',
          ]}
        >
          {link.label}
        
          {link.external && (
            <svg
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              class="transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
            >
              <path d="M7 17 17 7" />
              <path d="M7 7h10v10" />
            </svg>
          )}
        </a>
      ))}
      <button
        type="button"
        id="theme-toggle"
        data-theme-toggle
        aria-label="Dark theme"
        aria-pressed="false"
        class="cursor-pointer text-ink-faint transition-colors hover:text-ink"
      >
        <svg class="theme-icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32 1.41-1.41" />
        </svg>
        <svg class="theme-icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>
      <a
        href="https://github.com/StratumServer/Stratum"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="text-ink-faint transition-colors hover:text-ink"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
      </a>
    </div>

    <details class="mobile-site-nav group relative lg:hidden">
      <summary class="flex min-h-11 cursor-pointer list-none items-center gap-2 rounded border border-parchment-line bg-parchment-panel px-3 font-mono text-xs font-semibold uppercase tracking-widest text-ink-soft focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ochre [&::-webkit-details-marker]:hidden">
        Menu
        <svg class="h-4 w-4 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="m5 7.5 5 5 5-5" />
        </svg>
      </summary>
      <div class="absolute right-0 top-full z-[60] mt-2 flex w-64 flex-col gap-1 rounded border border-parchment-line bg-parchment-panel p-3 shadow-xl">
        {links.map(link => (
          <a
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
            class:list={[
              'flex min-h-11 items-center justify-between rounded px-3 text-sm transition-colors hover:bg-parchment-sunk hover:text-ink',
              link.project
                ? 'text-ochre-deep'
                : !link.external && currentPath.startsWith(link.href)
                  ? 'font-semibold text-ink'
                  : 'text-ink-soft',
            ]}
          >
            {link.label}
            {link.external && <span aria-hidden="true">↗</span>}
          </a>
        ))}
        <div class="my-1 border-t border-parchment-line" aria-hidden="true"></div>
        <button
          type="button"
          data-theme-toggle
          aria-label="Toggle theme"
          aria-pressed="false"
          class="flex min-h-11 items-center gap-3 rounded px-3 text-left text-sm text-ink-soft transition-colors hover:bg-parchment-sunk hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ochre"
        >
          <span>Toggle theme</span>
        </button>
        <a
          href="https://github.com/StratumServer/Stratum"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="flex min-h-11 items-center gap-3 rounded px-3 text-sm text-ink-soft transition-colors hover:bg-parchment-sunk hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ochre"
        >
          GitHub
        </a>
      </div>
    </details>
  </nav>
</header>

<style>
  .theme-icon-moon {
    display: none;
  }
  :global([data-theme='dark']) .theme-icon-moon {
    display: block;
  }
  :global([data-theme='dark']) .theme-icon-sun {
    display: none;
  }
</style>

<script>
  const toggles = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
  const syncButton = () => {
    const pressed = String(document.documentElement.dataset.theme === 'dark');
    toggles.forEach(toggle => toggle.setAttribute('aria-pressed', pressed));
  };
  syncButton();
  toggles.forEach(toggle => toggle.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute('content', next === 'dark' ? '#201a13' : '#f1e7d1');
    syncButton();
  }));
</script>
